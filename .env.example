# Supabase - required
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
REGISTRATION_RATE_LIMIT_SECRET=

# Beta safety: keep false. Enable only for a controlled one-time legacy operation.
ENABLE_LEGACY_SMARTSUITE_ROUTES=false

# Legacy SmartSuite values are intentionally optional in beta.
SMARTSUITE_API_KEY=
SMARTSUITE_ACCOUNT_ID=
SMARTSUITE_INFLUENCERS_TABLE_ID=
SMARTSUITE_SOCIAL_ACCOUNTS_TABLE_ID=
SMARTSUITE_CAMPAIGNS_TABLE_ID=
SMARTSUITE_CAMPAIGN_INFLUENCERS_TABLE_ID=
SMARTSUITE_CONTENT_LIBRARY_TABLE_ID=
SMARTSUITE_PAYMENTS_TABLE_ID=
SMARTSUITE_COORDINATORS_TABLE_ID=
